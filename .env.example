# Only the docs' "Describe a vibe" box reads these (api/vibe.mjs). With none
# set, rules match a description to a vibe, and the page says so.
# Copy to .env.local for `vercel dev`, or set them on the Vercel project.

# A Google AI Studio key. Without it the rules answer.
GEMINI_API_KEY=

# Optional: the model to ask first (default gemini-3.5-flash-lite).
GEMINI_MODEL=

# Optional: comma-separated models to try when the first is busy, or "none".
GEMINI_FALLBACK_MODELS=
