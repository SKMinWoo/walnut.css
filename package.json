{
  "name": "walnut.css",
  "version": "0.4.0",
  "description": "A cinematic CSS framework you theme by writing a colour script: one ground rod, five cues. Mid-century catalogued finish, zero JavaScript.",
  "keywords": [
    "css",
    "css-framework",
    "oklch",
    "container-queries",
    "scroll-animations",
    "design-system",
    "dark-mode",
    "cinematic",
    "modern-css",
    "light-dark",
    "theming",
    "color-scheme"
  ],
  "author": "Alex Kim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SKMinWoo/walnut.css"
  },
  "homepage": "https://github.com/SKMinWoo/walnut.css",
  "main": "dist/walnut.css",
  "style": "dist/walnut.css",
  "exports": {
    ".": "./dist/walnut.css",
    "./min": "./dist/walnut.min.css",
    "./themes/*": "./dist/themes/*.css",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "node build.js",
    "dev": "npx serve docs",
    "prepublishOnly": "node build.js"
  },
  "devDependencies": {}
}
