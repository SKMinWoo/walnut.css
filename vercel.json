{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    { "source": "/next", "destination": "/", "permanent": true },
    { "source": "/reference", "destination": "/#reference", "permanent": true },
    { "source": "/reference.html", "destination": "/#reference", "permanent": true },
    { "source": "/openings", "destination": "/#motion", "permanent": true },
    { "source": "/openings.html", "destination": "/#motion", "permanent": true },
    { "source": "/specimen", "destination": "/#motion-full-page", "permanent": true },
    { "source": "/specimen.html", "destination": "/#motion-full-page", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'sha256-b+xnOcMmMaqRp03rdSM7mimcubsy6x0XhM2BacT5aaY=' 'sha256-HLhwNaHVXfLuILZ14NHe1J4P2k2gBJhlKGLEMYhejsA='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://picsum.photos https://fastly.picsum.photos; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; manifest-src 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/dist/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
